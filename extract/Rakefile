LANGUAGES = %i[ja en de es-ES]
TRANSLATE_PLACEHOLDER = "(translate here)"
COMPANION_SECTION = "AviUtl2 Community Translation"

task default: %i[
       clean
       prepare
       build_plugin
       download_aviutl2
       extract_locale
       extract_effects
       list_effects
       update_source
       update_aul2
     ]

task :clean do
  rm_rf "tmp"
  puts "Cleaned up temporary files."
end
task :prepare do
  mkdir_p "tmp"
  File.write("tmp/.gitignore", "*\n")
  puts "Prepared temporary directory."
end

task :build_plugin do
  if Gem.win_platform?
    sh "cargo build --release -p extract_plugin", chdir: "./plugin"
  else
    puts "Skipping plugin build on non-Windows platform."
  end
end

task :download_aviutl2 do
  require "open-uri"
  require "zip"
  require "json"

  installer_url = "https://api.aviutl2.jp/download?version=latest&type=installer"
  installer_path = "tmp/aviutl2_setup.exe"

  puts "Downloading installer #{installer_url}..."
  URI.open(installer_url) do |remote_file|
    File.open(installer_path, "wb") do |file|
      IO.copy_stream(remote_file, file)
    end
  end
  puts "Downloaded installer to #{installer_path}."

  zip_url = "https://api.aviutl2.jp/download?version=latest&type=zip"
  zip_path = "tmp/aviutl2.zip"
  puts "Downloading ZIP #{zip_url}..."
  URI.open(zip_url) do |remote_file|
    File.open(zip_path, "wb") do |file|
      IO.copy_stream(remote_file, file)
    end
  end

  Zip::File.open(zip_path) do |zip_file|
    zip_file.each do |entry|
      dest_path = File.join("tmp", "aviutl2", entry.name)
      mkdir_p File.dirname(dest_path) unless Dir.exist?(File.dirname(dest_path))
      zip_file.extract(entry, dest_path) unless File.exist?(dest_path)
    end
  end
  puts "Extracted ZIP to tmp/aviutl2."
end

task :extract_locale do
  require "open3"
  require "fileutils"
  require "zip"

  puts "Extracting locale data..."
  # ; ProgramData\aviutl2\Language
  installer_path = "tmp/aviutl2_setup.exe"
  output = File.read(installer_path, mode: "rb")
  last_offset = 0
  zip_signature = "PK\x03\x04"
  found = false
  while (offset = output.index(zip_signature, last_offset))
    begin
      zip_data = output[offset..-1]
      puts "Found potential ZIP at offset #{offset}. Attempting to parse..."
      Zip::File.open_buffer(zip_data) do |zip_file|
        zip_file.each do |entry|
          if entry.name == "English.aul2"
            dest_path = "tmp/original_english.aul2"
            puts "Extracting #{entry.name} to #{dest_path}..."
            entry.extract(dest_path) { true }
            puts "Extracted English.aul2 to #{dest_path}."
            content = File.read(dest_path)
            File.write("../locales/original_english.aul2", content.gsub("\r\n", "\n"), mode: "wb")
            found = true
          end
        end
      end
      puts "Successfully parsed ZIP at offset #{offset}."
    rescue Zip::Error => e
      puts "Failed to parse ZIP at offset #{offset}: #{e.message}"
    end
    last_offset = offset + 4
  end

  unless found
    raise "Failed to find and extract English.aul2 from installer. ZIP signature search exhausted."
  end
end

task :extract_effects do
  require "open3"
  puts "Extracting effects..."

  rm_rf "./tmp/aviutl2/data"
  mkdir_p "./tmp/aviutl2/data/Plugin"
  cp "../target/release/extract_plugin.dll",
     "./tmp/aviutl2/data/Plugin/ExtractPlugin.aux2"
  mkdir_p "./tmp/aviutl2/data/extract"

  mode_path = "./tmp/aviutl2/data/extract/mode.txt"
  File.write(mode_path, "extract")

  puts "Trusting ExtractPlugin.aux2 for effect extraction."
  File.write("./tmp/aviutl2/data/module.ini", <<~INI)
    [ExtractPlugin.aux2]
    trust=1
  INI
  puts "Launching AviUtl2 to extract effects..."

  current_time = Time.now
  spawn("tmp/aviutl2/AviUtl2.exe")
  while Time.now - current_time < 60
    sleep 1
    unless File.exist?(mode_path)
      puts "Effect extraction completed."
      break
    end
  end

  rm_rf "./tmp/extracted_effects"
  cp_r "./tmp/aviutl2/data/extract/effects", "./tmp/extracted_effects"
end

task :list_effects do
  require "json"
  require "inifile"
  puts "Listing extracted effects..."
  effects_dir = "./tmp/extracted_effects"
  effects = {}
  Dir
    .glob("#{effects_dir}/*.json")
    .each do |path|
      effect_data = JSON.parse(File.read(path))
      effect_name = effect_data["name"]
      effect_keys = effect_data["parameters"]
      if effect_data["common"]
        common_effects[effect_name] = effect_keys
      else
        effects[effect_name] = effect_keys
      end
    end

  File.write(
    "./effects.json",
    JSON.pretty_generate({ **effects })
  )
  puts "Wrote effects list to ./tmp/effects.json."
end

task :update_source do
  require "inifile"
  require "yaml"
  require "json"

  LANGUAGES.each do |lang|
    unless Dir.exist?("../translations/#{lang}")
      mkdir_p "../translations/#{lang}"
    end
  end

  puts "Updating translation source..."

  main_translations = IniFile.load("../locales/original_english.aul2")
  companion_texts = YAML.load_file("../companion/texts.yml")
  effects = JSON.parse(File.read("./effects.json"))
  effect_keys = effects.keys.to_set
  LANGUAGES.each do |lang|
    editor_file_path = "../translations/#{lang}/editor.yml"
    current_translations =
      (
        File.exist?(editor_file_path) ? YAML.load_file(editor_file_path) : {}
      ).to_h
    translations = {}
    main_translations.each_section do |section|
      translations[section] = {}
      main_translations[section].each do |key, value|
        translate_in_effect = section == "Effect" && effect_keys.include?(key)
        if translate_in_effect
          next
        elsif lang == :ja
          translations[section][key] = key
        elsif is_translated?(current_translations.dig(section, key))
          translations[section][key] = current_translations.dig(section, key)
        else
          translations[section][key] = nil
        end
      end
    end
    File.open(editor_file_path, "w") do |file|
      translations.each do |section_name, section_content|
        file.puts "#{section_name}:"
        section_content.each do |key, value|
          main_translations[section_name][key].lines.each do |line|
            file.puts "  # #{line.chomp}".rstrip
          end
          file.puts "  '#{key}': |"
          if value.nil?
            file.puts "    #{TRANSLATE_PLACEHOLDER}"
          else
            value.lines.each { |line| file.puts "    #{line.chomp}".rstrip }
          end
          file.puts
        end
      end
    end

    puts "Updated translation source for #{lang} at #{editor_file_path}."

    companion_file_path = "../translations/#{lang}/companion.yml"
    current_companion_translations =
      (
        if File.exist?(companion_file_path)
          YAML.load_file(companion_file_path)
        else
          {}
        end
      ).to_h
    companion_translations = { COMPANION_SECTION => {} }
    companion_texts.each do |text|
      if lang == :ja
        companion_translations[COMPANION_SECTION][text] = text
      elsif is_translated?(
            current_companion_translations.dig(COMPANION_SECTION, text)
          )
        companion_translations[COMPANION_SECTION][
          text
        ] = current_companion_translations.dig(COMPANION_SECTION, text)
      else
        companion_translations[COMPANION_SECTION][text] = nil
      end
    end

    File.open(companion_file_path, "w") do |file|
      companion_translations.each do |section_name, section_content|
        file.puts "'#{section_name}':"
        section_content.each do |key, value|
          file.puts "  '#{key}': |"
          if value.nil?
            file.puts "    #{TRANSLATE_PLACEHOLDER}"
          else
            value.lines.each { |line| file.puts "    #{line.chomp}".rstrip }
          end
          file.puts
        end
      end
    end
    puts "Updated companion translation source for #{lang} at #{companion_file_path}."

    effect_file_path = "../translations/#{lang}/effects.yml"
    current_effect_translations =
      (
        File.exist?(effect_file_path) ? YAML.load_file(effect_file_path) : {}
      ).to_h
    effect_translations = {}
    effects.each do |effect_name, keys|
      effect_translations[effect_name] = { effect_name => nil }
      if lang == :ja
        effect_translations[effect_name][effect_name] = effect_name
      elsif is_translated?(
            current_effect_translations.dig(effect_name, effect_name)
          )
        effect_translations[effect_name][
          effect_name
        ] = current_effect_translations.dig(effect_name, effect_name)
      end
      keys.each do |key|
        if lang == :ja
          effect_translations[effect_name][key] = key
        elsif is_translated?(current_effect_translations.dig(effect_name, key))
          effect_translations[effect_name][
            key
          ] = current_effect_translations.dig(effect_name, key)
        else
          effect_translations[effect_name][key] = nil
        end
      end
    end

    File.open(effect_file_path, "w") do |file|
      effect_translations.each do |effect_name, section_content|
        file.puts "'#{effect_name}':"
        section_content.each do |key, value|
          if main_translations["Effect"].key?(key)
            main_translations["Effect"][key].lines.each do |line|
              file.puts "  # #{line.chomp}".rstrip
            end
          else
            file.puts "  # (No default text available)"
          end
          file.puts "  '#{key}': |"
          if value.nil?
            file.puts "    #{TRANSLATE_PLACEHOLDER}"
          else
            value.lines.each { |line| file.puts "    #{line.chomp}" }
          end
          # file.puts
        end
      end
    end
    puts "Updated effect translation source for #{lang} at #{effect_file_path}."
  end
end

task :update_aul2 do
  require "yaml"
  require "inifile"
  require "json"
  require "digest/xxhash"

  main_translations = IniFile.load("../locales/original_english.aul2")
  english_editor_translations =
    (
      if File.exist?("../translations/en/editor.yml")
        YAML.load_file("../translations/en/editor.yml")
      else
        {}
      end
    ).to_h
  english_effect_translations =
    (
      if File.exist?("../translations/en/effects.yml")
        YAML.load_file("../translations/en/effects.yml")
      else
        {}
      end
    ).to_h
  english_companion_translations =
    (
      if File.exist?("../translations/en/companion.yml")
        YAML.load_file("../translations/en/companion.yml")
      else
        {}
      end
    ).to_h
  LANGUAGES.each do |lang|
    puts "Building localized .aul2 for #{lang}..."
    editor_file_path = "../translations/#{lang}/editor.yml"
    effect_file_path = "../translations/#{lang}/effects.yml"
    companion_file_path = "../translations/#{lang}/companion.yml"
    editor_translations = YAML.load_file(editor_file_path).to_h
    effect_translations = YAML.load_file(effect_file_path).to_h
    companion_translations =
      (
        if File.exist?(companion_file_path)
          YAML.load_file(companion_file_path)
        else
          {}
        end
      ).to_h
    use_english_fallback = !%i[en ja].include?(lang)

    sections = {}
    num_translated = 0
    num_total = 0
    main_translations.each_section do |section|
      sections[section] = {}
      main_translations[section].each do |key, value|
        translated_value = editor_translations.dig(section, key)
        if section == "Effect" && effect_translations.dig(key, key)
          translated_value = effect_translations.dig(key, key)
        end
        fallback_value = nil
        if use_english_fallback
          if section == "Effect"
            fallback_value = english_effect_translations.dig(key, key)
          end
          fallback_value ||= english_editor_translations.dig(section, key)
        end
        num_total += 1
        if is_translated?(translated_value&.chomp)
          num_translated += 1
          sections[section][key] = translated_value.chomp
        elsif is_translated?(fallback_value&.chomp)
          sections[section][key] = fallback_value.chomp
        else
          sections[section][key] = value
        end
      end
    end
    effect_names = effect_translations.keys
    effect_names |= english_effect_translations.keys if use_english_fallback
    effect_names.each do |effect_name|
      sections[effect_name] ||= {}
      effect_params = effect_translations.fetch(effect_name, {})
      english_effect_params = english_effect_translations.fetch(effect_name, {})
      effect_keys = effect_params.keys
      effect_keys |= english_effect_params.keys if use_english_fallback
      effect_keys.each do |key|
        translated_value = effect_params[key]
        english_fallback_value = english_effect_params[key]
        num_total += 1
        if is_translated?(translated_value&.chomp)
          num_translated += 1
          sections[effect_name][key] = translated_value.chomp
        elsif use_english_fallback &&
              is_translated?(english_fallback_value&.chomp)
          sections[effect_name][key] = english_fallback_value.chomp
        end
      end
    end

    companion_entries = companion_translations.fetch(COMPANION_SECTION, {})
    english_companion_entries =
      english_companion_translations.fetch(COMPANION_SECTION, {})
    companion_keys = companion_entries.keys
    companion_keys |= english_companion_entries.keys if use_english_fallback
    unless companion_keys.empty?
      sections[COMPANION_SECTION] ||= {}
      companion_keys.each do |key|
        translated_value = companion_entries[key]
        english_fallback_value = english_companion_entries[key]
        num_total += 1
        if is_translated?(translated_value&.chomp)
          num_translated += 1
          sections[COMPANION_SECTION][key] = translated_value.chomp
        elsif use_english_fallback &&
              is_translated?(english_fallback_value&.chomp)
          sections[COMPANION_SECTION][key] = english_fallback_value.chomp
        else
          sections[COMPANION_SECTION][key] = key
        end
      end
    end

    output_path = "../locales/community_#{lang}.aul2"
    File.open(output_path, "w") do |file|
      file.puts "; AviUtl2 Community Translation (#{lang})"
      file.puts "; Generated automatically. Do not edit directly."
      file.puts "; Translated #{num_translated} of #{num_total} entries (#{
                  (num_translated.to_f / num_total * 100).round(2)
                }%)."
      file.puts "; Source:"
      file.puts ";   https://github.com/aviutl2/aviutl2_community_translation"
      file.puts
      sections.each do |section_name, section_content|
        next if section_content.empty?
        file.puts "[#{section_name}]"
        section_content.each do |key, value|
          escaped_value = value.gsub("\n", "\\n")
          file.puts "#{key}=#{escaped_value}"
        end
        file.puts
      end
    end
    puts "Wrote localized .aul2 to #{output_path}."
    puts "Translation progress: #{num_translated}/#{num_total} (#{
           (num_translated.to_f / num_total * 100).round(2)
         }%)."
  end

  hash_target_paths =
    Dir
      .glob("../locales/community_*.aul2")
      .reject { |path| path.end_with?("community_ja.aul2") }
      .sort
  files = {}
  hash_target_paths.each do |path|
    files[File.basename(path)] = xxh3_64_hex(path)
  end
  files = files.sort.to_h
  files_index_path = "../locales/files.json"
  File.write(
    files_index_path,
    JSON.pretty_generate({ version: 1, files: files }) + "\n"
  )
  puts "Wrote locale hash index to #{files_index_path}."
end

def xxh3_64_hex(path)
  data = File.binread(path)
  xxh3_class =
    begin
      Digest.const_get(:XXH3_64bits)
    rescue StandardError
      nil
    end
  unless xxh3_class&.respond_to?(:hexdigest)
    xxh3_class =
      Digest
        .constants
        .map do |name|
          begin
            Digest.const_get(name)
          rescue StandardError
            nil
          end
        end
        .find do |klass|
          klass.is_a?(Class) && klass.name.include?("XXH3_64") &&
            klass.respond_to?(:hexdigest)
        end
  end
  raise "digest-xxhash does not expose XXH3 hexdigest API." if xxh3_class.nil?

  digest = xxh3_class.hexdigest(data).downcase
  digest.rjust(16, "0")[-16..]
end

def is_translated?(text)
  return false if text.nil?

  stripped = text.strip
  return false if stripped.empty?
  return false if stripped == TRANSLATE_PLACEHOLDER

  true
end

namespace :crowdin do
  task :list_projects do
    require "crowdin-api"
    require "dotenv/load"

    client =
      Crowdin::Client.new { |config| config.api_token = ENV["CROWDIN_TOKEN"] }
    projects = client.list_projects

    projects["data"].each do |project|
      puts "Project ID: #{project["data"]["id"]}, Name: #{project["data"]["name"]}"
    end
  end

  task :upload_source do
    require "crowdin-api"
    require "dotenv/load"

    crowdin =
      Crowdin::Client.new do |config|
        config.api_token = ENV["CROWDIN_TOKEN"]
        config.project_id = ENV["CROWDIN_PROJECT_ID"]
      end

    editor_file_path = "../translations/ja/editor.yml"
    companion_file_path = "../translations/ja/companion.yml"
    effect_file_path = "../translations/ja/effects.yml"

    files = crowdin.list_files
    [editor_file_path, companion_file_path, effect_file_path].each do |path|
      puts "Uploading #{path} to Crowdin..."
      storage_id = crowdin.add_storage(File.open(path, "r"))["data"]["id"]
      existing_file_id =
        files["data"]
          .find { |f| f["data"]["name"] == File.basename(path).to_s }
          &.dig("data", "id")

      if existing_file_id
        response =
          crowdin.update_or_restore_file(
            existing_file_id,
            storageId: storage_id
          )
        raise "Failed to update file on Crowdin" unless response["data"]
        puts "Updated #{path} on Crowdin."
      else
        response =
          crowdin.add_file(storageId: storage_id, name: File.basename(path))
        raise "Failed to add file to Crowdin" unless response["data"]
        puts "Added #{path} as a new file on Crowdin."
      end
    end
  end
  task :download_translations do
    require "crowdin-api"
    require "open-uri"
    require "zip"
    require "dotenv/load"

    crowdin =
      Crowdin::Client.new do |config|
        config.api_token = ENV["CROWDIN_TOKEN"]
        config.project_id = ENV["CROWDIN_PROJECT_ID"]
      end

    puts "Downloading translations from Crowdin..."
    build_id = crowdin.build_project_translation["data"]["id"]
    status_response = nil
    loop do
      status_response = crowdin.check_project_build_status(build_id)
      if status_response["data"]["status"] == "finished"
        break
      else
        puts "Translation build status: #{status_response["data"]["status"]}. Waiting..."
        sleep 5
      end
    end
    download_url =
      crowdin.download_project_translations(build_id)["data"]["url"]
    zip_path = "tmp/crowdin_translations.zip"
    URI.open(download_url) do |remote_file|
      File.open(zip_path, "wb") { |file| file.write(remote_file.read) }
    end

    Dir.chdir("..") do
      Zip::File.open("./extract/" + zip_path) do |zip_file|
        zip_file.each do |entry|
          next if entry.name.end_with?("/")
          dest_path = File.join(".", "translations", entry.name)
          unless Dir.exist?(File.dirname(dest_path))
            mkdir_p File.dirname(dest_path)
          end
          puts "Extracting #{entry.name} to #{dest_path}..."
          rm dest_path if File.exist?(dest_path)
          zip_file.extract(entry, dest_path)
        end
      end
    end
  end

  task sync: %i[upload_source download_translations]
end
